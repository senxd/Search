{
  "name": "form-enter",
  "tags": ["form"],
  "prompt": "On the open tab titled Key Log, focus the field, type \"hello world\", then press Enter.",
  "setup": {"tabs": [
    {"url": "fixture:keys", "as": "k", "via": "bench"}
  ]},
  "verify": {"kind": "js", "tab": "k",
    "js": "document.querySelectorAll('#log li').length === 1 && document.querySelector('#log li').textContent === 'hello world'"},
  "timeout": 90
}
