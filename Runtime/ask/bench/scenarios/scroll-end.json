{
  "name": "scroll-end",
  "tags": ["scroll"],
  "prompt": "Scroll all the way to the bottom of the open tab titled Long Scroll and tell me what the last line says.",
  "setup": {"tabs": [
    {"url": "fixture:longscroll", "as": "s", "via": "bench"}
  ]},
  "verify": {"kind": "all", "checks": [
    {"kind": "chat", "expect": "the end", "i": true},
    {"kind": "js", "tab": "s", "js": "!!document.getElementById('the-end') && document.getElementById('the-end').getBoundingClientRect().bottom <= window.innerHeight + 1 && window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 1"}
  ]},
  "timeout": 120
}
